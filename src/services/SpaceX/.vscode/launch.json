{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SpaceX API",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/SpaceX.Api/SpaceX.Api.csproj",
      "launchProfile": "https"
    },
    {
      "name": "SpaceX API (coreclr)",
      "type": "coreclr",
      "request": "launch",
      "projectPath": "${workspaceFolder}/SpaceX.Api/SpaceX.Api.csproj",
      "launchSettingsProfile": "https",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
